datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  SALE_STAFF
  WAREHOUSE_STAFF
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  COD
  VIETQR
  VNPAY
  MOMO
  INSTALLMENT_CREDIT
  INSTALLMENT_FINANCE
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum ImeiStatus {
  IN_STOCK
  SOLD
  DEFECTIVE
  WARRANTY
}

enum DeliveryMethod {
  HOME_DELIVERY
  STORE_PICKUP
}

model User {
  id             String          @id @default(uuid())
  name           String
  phone          String          @unique
  email          String?         @unique
  password       String
  role           Role            @default(CUSTOMER)
  loyaltyPoints  Int             @default(0)
  membershipRank String          @default("BRONZE")
  isActive       Boolean         @default(true)
  orders         Order[]
  installments   InstallmentRequest[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  icon      String?
  parentId  Int?
  order     Int       @default(0)
  isActive  Boolean   @default(true)
  products  Product[]
}

model Brand {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  logo      String?
  isActive  Boolean   @default(true)
  products  Product[]
}

model Product {
  id             String           @id @default(uuid())
  name           String
  slug           String           @unique
  categoryId     Int
  brandId        Int
  category       Category         @relation(fields: [categoryId], references: [id])
  brand          Brand            @relation(fields: [brandId], references: [id])
  thumbnail      String
  images         String[]
  description    String           @db.Text
  highlights     String[]
  specs          Json             // Dynamic technical specifications (RAM, Chip, Display, Battery...)
  warrantyMonths Int              @default(12)
  isFeatured     Boolean          @default(false)
  isActive       Boolean          @default(true)
  variants       ProductVariant[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ProductVariant {
  id             String           @id @default(uuid())
  productId      String
  product        Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String           @unique
  colorName      String           // e.g. "Titan Tự Nhiên"
  colorCode      String           // Hex code e.g. "#C5B49E"
  storage        String           // e.g. "256GB"
  originalPrice  Decimal          @db.Decimal(12, 2)
  salePrice      Decimal          @db.Decimal(12, 2)
  costPrice      Decimal?         @db.Decimal(12, 2)
  image          String?
  stockQuantity  Int              @default(0)
  isActive       Boolean          @default(true)
  imeis          InventoryIMEI[]
  orderItems     OrderItem[]
  flashSaleItems FlashSaleItem[]
  installments   InstallmentRequest[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model InventoryIMEI {
  id            String         @id @default(uuid())
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  imei          String         @unique
  status        ImeiStatus     @default(IN_STOCK)
  storeLocation String         @default("Kho Tổng")
  importDate    DateTime       @default(now())
  soldDate      DateTime?
  orderId       String?
  order         Order?         @relation(fields: [orderId], references: [id])
}

model Order {
  id             String          @id @default(uuid())
  orderCode      String          @unique
  userId         String?
  user           User?           @relation(fields: [userId], references: [id])
  customerName   String
  customerPhone  String
  customerEmail  String?
  deliveryMethod DeliveryMethod  @default(HOME_DELIVERY)
  shippingAddress String?
  city           String?
  district       String?
  ward           String?
  pickupStore    String?
  paymentMethod  PaymentMethod   @default(COD)
  paymentStatus  PaymentStatus   @default(PENDING)
  orderStatus    OrderStatus     @default(PENDING)
  subTotal       Decimal         @db.Decimal(12, 2)
  discountAmount Decimal         @default(0) @db.Decimal(12, 2)
  shippingFee    Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal         @db.Decimal(12, 2)
  notes          String?         @db.Text
  items          OrderItem[]
  imeis          InventoryIMEI[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model OrderItem {
  id           String         @id @default(uuid())
  orderId      String
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  productName  String
  variantName  String
  price        Decimal        @db.Decimal(12, 2)
  quantity     Int            @default(1)
  assignedImei String?
}

model FlashSale {
  id        String          @id @default(uuid())
  title     String
  startTime DateTime
  endTime   DateTime
  isActive  Boolean         @default(true)
  items     FlashSaleItem[]
}

model FlashSaleItem {
  id           String         @id @default(uuid())
  flashSaleId  String
  flashSale    FlashSale      @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  salePrice    Decimal        @db.Decimal(12, 2)
  saleQuantity Int
  soldQuantity Int            @default(0)
}

model InstallmentRequest {
  id               String         @id @default(uuid())
  requestCode      String         @unique
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  userId           String?
  user             User?          @relation(fields: [userId], references: [id])
  fullName         String
  phoneNumber      String
  idCardNumber     String
  financialCompany String         // e.g. "HOME_CREDIT", "FE_CREDIT", "CREDIT_CARD"
  prepaidPercent   Int            // 0, 20, 30...
  termMonths       Int            // 6, 9, 12...
  monthlyPayment   Decimal        @db.Decimal(12, 2)
  status           String         @default("PENDING_REVIEW")
  adminNote        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}
